# MongoDB Atlas connection string. Keep your real value in the ignored .env file.
# Local server port; hosting platforms provide PORT automatically.
PORT=3001
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/portfolio_db?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio_db
# Optional: only if your network blocks Atlas SRV DNS lookups.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Admin sign-in. Prefer the bcrypt hash in production.
ADMIN_USERNAME=your-admin-id
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Cloudinary image storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Your production HTTPS origin, once deployed.
SITE_URL=https://your-domain.com
